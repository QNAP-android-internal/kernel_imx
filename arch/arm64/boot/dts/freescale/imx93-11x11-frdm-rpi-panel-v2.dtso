#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
/plugin/;

&dphy {
	status = "okay";
};

&dsi {
	status = "okay";

	ports {
		port@1 {
			reg = <1>;
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};

	dsi_panel: dsi_panel@0 {
		reg = <0>;
		compatible = "raspberrypi,dsi-7inch";
		reset-gpio = <&rpi_display_v2_mcu 0 GPIO_ACTIVE_LOW>;
		backlight = <&rpi_display_v2_mcu>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&ldb {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&lpi2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	lvds_bridge: lvds-to-hdmi-bridge@4c {
		status = "disabled";
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		touchscreen-size-x = <720>;
		touchscreen-size-y = <1280>;
		touchscreen-x-mm = <90>;
		touchscreen-y-mm = <151>;
	};


	rpi_display_v2_mcu: rpi_display_v2_mcu@45
	{
		compatible = "raspberrypi,v2-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;

		touch-reg-hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_HIGH>;
			output-high;
		};
	};
};
