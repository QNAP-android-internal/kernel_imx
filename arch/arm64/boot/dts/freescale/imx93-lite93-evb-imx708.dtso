#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
/plugin/;

&{/} {
	clk_ext: clock-external {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_ext";
	};

	reg_1v1: regulator-1v1 {
		compatible = "regulator-fixed";
		regulator-name = "1V1";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
	};

	reg_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_2v8: regulator-2v8 {
		compatible = "regulator-fixed";
		regulator-name = "2V8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};
};

&dphy {
	status = "okay";
};

&dphy_rx {
	status = "okay";
};

&isi {
	status = "okay";

	port {
		isi_in: endpoint {
			remote-endpoint = <&mipi_csi_out>;
		};
	};
};

&mipi_csi {
	snps,enable-embedded-data;
	dwc_color_16bit_enable;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			mipi_csi_in: endpoint {
				remote-endpoint = <&imx708_out>;
				data-lanes = <1 2>;
				clock-lanes = <0>;
			};
		};

		port@1 {
			reg = <1>;

			mipi_csi_out: endpoint {
				remote-endpoint = <&isi_in>;
			};
		};
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	imx708: sensor@1a {
		compatible = "sony,imx708";
		imx708,low-fps-mode;

		reg = <0x1a>;
		reset-gpios = <&pcal6524 22 GPIO_ACTIVE_HIGH>;
		clocks = <&clk_ext>;
		VANA1-supply = <&reg_1v8>; /* 1.8v */
		VANA2-supply = <&reg_2v8>; /* 2.8v */
		VDIG-supply = <&reg_1v1>;  /* 1.1v */
		VDDL-supply = <&reg_1v8>;  /* 1.8v */

		port {
			imx708_out: endpoint {
				remote-endpoint = <&mipi_csi_in>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <382500000>;
			};
		};
	};
};
